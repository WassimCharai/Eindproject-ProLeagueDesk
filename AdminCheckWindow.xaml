<Window x:Class="ProLeagueDesk.AdminCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProLeagueDesk"
        mc:Ignorable="d"
        Title="Admin Verificatie" Height="180" Width="300" WindowStartupLocation="CenterScreen"
        Icon="/image/mijnlogo.ico">
    <StackPanel Margin="15">

        <TextBlock Text="Admin wachtwoord vereist" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
        <PasswordBox Name="tbAdminPass" Height="25" Margin="0,0,0,10"/>
        <Button Name="btnConfirm" Height="30" Click="btnConfirm_Click">Bevestigen</Button>
        
    </StackPanel>
</Window>
