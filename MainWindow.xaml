<Window x:Class="ProLeagueDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="500" Width="900"
        Icon="/image/mijnlogo.ico"
        Background="#EDEDED"
        ResizeMode="NoResize">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#15002B" BorderBrush="#DDD" BorderThickness="0,0,1,0">
            <StackPanel VerticalAlignment="Top" Margin="0,40,0,0">
                <Image Source="/image/mijnlogo.jpg" Width="150" Height="150" HorizontalAlignment="Center"></Image>
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="1" Margin="40,60,40,40" HorizontalAlignment="Left">

            <TextBlock FontSize="36" FontWeight="Bold" Foreground="#333">ProLeague Desk</TextBlock>
            <TextBlock FontSize="16" Foreground="Gray" Margin="0,5,0,30">The Ultimate Football Managing Application</TextBlock>

            <StackPanel Width="350" HorizontalAlignment="Left">
                <TextBlock Margin="0,10,0,5" FontWeight="SemiBold">Gebruikersnaam</TextBlock>
                <TextBox Name="tbUsername" VerticalContentAlignment="Center" Padding="5"></TextBox>

                <TextBlock Margin="0,15,0,5" FontWeight="SemiBold">Wachtwoord</TextBlock>
                <Grid Height="30">
                    <PasswordBox Name="tbPassword" Padding="5" VerticalContentAlignment="Center"></PasswordBox>
                    <TextBox Name="tbPasswordVisible" Padding="5" Visibility="Collapsed" VerticalContentAlignment="Center"></TextBox>
                    <Button Width="30" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" Cursor="Hand" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp">👁</Button>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                    <Button Name="btnLogin" Click="btnLogin_Click" Width="110" Height="35" Background="#8BC34A" Foreground="White" BorderBrush="Transparent" Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources> Login
                    </Button>
                    <Button Name="btnRegistreer" Click="btnRegistreer_Click" Width="110" Height="35" Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources> Registreer
                    </Button>
                    <Button Name="btnExit" Click="btnExit_Click" Width="110" Height="35" Background="#E57373" Foreground="White" BorderBrush="Transparent">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources> Exit
                    </Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>