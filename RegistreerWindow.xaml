<Window x:Class="ProLeagueDesk.RegistreerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account Aanmaken" Height="550" Width="900"
        Icon="/image/mijnlogo.ico"
        Background="#EDEDED" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#15002B" BorderBrush="#DDD" BorderThickness="0,0,1,0">
            <Grid>
                <Button Name="Terug" Width="80" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Click="Terug_Click"  Background="Transparent" Foreground="White" BorderBrush="White">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources> ← Terug
                </Button>

                <StackPanel VerticalAlignment="Center">
                    <Image Source="/image/mijnlogo.jpg" Width="150" Height="150" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Column="1" Margin="40,40,40,40" HorizontalAlignment="Left">

            <TextBlock FontSize="32" FontWeight="Bold" Foreground="#333">Maak een account</TextBlock>
            <TextBlock FontSize="16" Foreground="Gray" Margin="0,5,0,30">Word onderdeel van het ProLeague management team</TextBlock>

            <StackPanel Width="400" HorizontalAlignment="Left">

                <TextBlock Margin="0,10,0,5" FontWeight="SemiBold">Gebruikersnaam</TextBlock>
                <TextBox Name="tbUsername" Height="30" VerticalContentAlignment="Center" Padding="5"></TextBox>

                <TextBlock Margin="0,15,0,5" FontWeight="SemiBold">Wachtwoord</TextBlock>
                <Grid Height="30">
                    <PasswordBox Name="tbPasswoord" Padding="5" VerticalContentAlignment="Center"/>
                    <TextBox Name="tbPasswoordVisible" Padding="5" Visibility="Collapsed" VerticalContentAlignment="Center"/>
                    <Button Width="30" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" Cursor="Hand" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp">👁</Button>
                </Grid>

                <TextBlock Margin="0,25,0,10" FontWeight="SemiBold" FontSize="16">Selecteer uw rol:</TextBlock>
                <StackPanel x:Name="RolePanel" Orientation="Horizontal" Margin="0,5,0,20">
                    <RadioButton GroupName="Roles" Content="Admin" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <RadioButton GroupName="Roles" Content="Scheidsrechter" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <RadioButton GroupName="Roles" Content="Coach" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Name="btnRegisteren" Click="btnRegisteren_Click" Height="40" Width="200" HorizontalAlignment="Left" Background="#2D8CFF" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Margin="0,10,0,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources> Account Aanmaken
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>