<Window x:Class="ProLeagueDesk.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Control Panel" Height="800" Width="1100"
        Icon="/image/mijnlogo.ico"
        Background="#EDEDED" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#15002B">
            <StackPanel Margin="20">
                <Image Source="/image/mijnlogo.jpg" Width="100" Height="100" Margin="0,0,0,10"/>
                <TextBlock Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30">PROLEAGUE DESK</TextBlock>

                <Border CornerRadius="10" Background="#250045" Padding="15" Margin="0,0,0,30">
                    <StackPanel>
                        <Ellipse Width="80" Height="80" Stroke="DodgerBlue" StrokeThickness="2">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="imgProfileBrush" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock x:Name="txtAdminInfo" Foreground="White" Margin="0,10,0,0" TextAlignment="Center" FontWeight="SemiBold"/>
                        <Button Name="btnAddPhoto" Click="btnAddPhoto_Click" Margin="0,10,0,0" Background="Transparent" Foreground="LightGray" BorderBrush="Gray" FontSize="10">Foto Wijzigen</Button>
                        <Button Name="btnRemovePhoto" Click="btnRemovePhoto_Click" Margin="0,5,0,0" Background="Transparent" Foreground="#E57373" BorderBrush="Transparent" FontSize="10">Foto Verwijderen</Button>
                    </StackPanel>
                </Border>

                <Button Name="btnGenereer" Click="btnGenereer_Click" Height="50" Margin="0,0,0,10" Background="Transparent" Foreground="White" BorderBrush="Transparent">
                    <StackPanel Orientation="Horizontal" Width="200">
                        <TextBlock FontSize="18" Margin="10,0,15,0" VerticalAlignment="Center">📅</TextBlock>
                        <TextBlock FontSize="15" VerticalAlignment="Center">Speelschema</TextBlock>
                    </StackPanel>
                </Button>

                <Button Name="btnBeheer" Click="btnBeheer_Click" Height="50" Margin="0,0,0,10" Background="Transparent" Foreground="White" BorderBrush="Transparent">
                    <StackPanel Orientation="Horizontal" Width="200">
                        <TextBlock Text="👥" FontSize="18" Margin="10,0,15,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Beheer Gebruikers" FontSize="15" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Name="btnStats" Click="btnStats_Click" Height="50" Margin="0,0,0,10" Background="Transparent" Foreground="White" BorderBrush="Transparent">
                    <StackPanel Orientation="Horizontal" Width="200">
                        <TextBlock FontSize="18" Margin="10,0,15,0" VerticalAlignment="Center">📊</TextBlock>
                        <TextBlock FontSize="15" VerticalAlignment="Center">Statistieken</TextBlock>
                    </StackPanel>
                </Button>

                <Button Name="btnLogout" Click="btnLogout_Click" Margin="0,50,0,0" Background="#8B3A3A" Foreground="White" Height="35" BorderBrush="Transparent">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources> Uitloggen</Button>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="30">

                <StackPanel x:Name="panelSpeelschema" Visibility="Visible">
                    <TextBlock FontSize="28" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20">Speelschema Genereren</TextBlock>

                    <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock FontWeight="Bold" Margin="0,0,0,15" FontSize="16">Competitie Instellingen</TextBlock>
                                <TextBlock Text="Seizoen" Margin="0,5"/>
                                <ComboBox Name="cbSeason" Height="30" Margin="0,0,0,15"/>
                                <TextBlock Text="Startdatum" Margin="0,5"/>
                                <DatePicker Name="dpStartDate" Height="30" Margin="0,0,0,15"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Team Selectie" FontWeight="Bold" Margin="0,0,0,15" FontSize="16"/>
                                <ListBox Name="lbTeams" Height="100" Margin="0,0,0,10" BorderBrush="#DDD"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Name="btnAddTeam" Click="btnAddTeam_Click" Background="#2D8CFF" Foreground="White" Padding="10,5" Margin="0,0,10,0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources> Team Toevoegen</Button>
                                    <Button Name="btnRemoveTeam" Click="btnRemoveTeam_Click" Background="#E57373" Foreground="White" Padding="10,5">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources> Verwijder</Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Name="btnGenerate" Click="btnGenerate_Click" Height="45" Width="350" Background="#8BC34A" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,15,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources> Genereer Speelschema</Button>

                        <Button Name="btnClearSchedule" Click="btnClearSchedule_Click" Height="45" Width="350" Background="#E57373" Foreground="White" FontSize="16" FontWeight="Bold">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources> 🗑️ Huidig Schema Wissen</Button>
                    </StackPanel>
                    
                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,10">Voorbeeld Gegenereerd Schema</TextBlock>
                    <DataGrid x:Name="dgPreview" Height="200" AutoGenerateColumns="False" Background="White" BorderBrush="#DDD" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Matchdag" Width="80" Binding="{Binding MatchdayNumber}"/>
                            <DataGridTextColumn Header="Thuis Ploeg" Width="*" Binding="{Binding HomeTeamName}"/>
                            <DataGridTextColumn Header="Uit Ploeg" Width="*" Binding="{Binding AwayTeamName}"/>
                            <DataGridTextColumn Header="Datum" Width="120" Binding="{Binding Date}"/>
                            <DataGridTextColumn Header="Scheidsrechter" Width="150" Binding="{Binding RefereeName}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" Margin="0,15,0,15" VerticalAlignment="Center">
                        <TextBlock Text="Selecteer een wedstrijd hierboven en kies de scheidsrechter:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                        <ComboBox x:Name="cbReferees" Width="180" Height="30" DisplayMemberPath="Name"/>
                        <Button x:Name="btnAssignReferee" Click="btnAssignReferee_Click" Content="Wijs Scheidsrechter Toe" Padding="15,0" Height="30" Margin="10,0,0,0" Background="#2D8CFF" Foreground="White" FontWeight="Bold">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Name="btnSave" Click="btnSave_Click" Width="150" Height="35" Background="#2D8CFF" Foreground="White" Margin="10,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources> 💾 Schema Opslaan</Button>
                        <Button Name="btnExport" Click="btnExport_Click" Width="120" Height="35">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources> 📤 Exporteren</Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="panelGebruikers" Visibility="Collapsed">
                    <TextBlock FontSize="28" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20">Gebruikersbeheer</TextBlock>

                    <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Margin="0,0,0,10" FontSize="16">Geregistreerde Gebruikers</TextBlock>

                            <DataGrid x:Name="dgUsers" Height="250" AutoGenerateColumns="False" Background="White" BorderBrush="#DDD" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="User ID" Width="80" Binding="{Binding UserId}"/>
                                    <DataGridTextColumn Header="Gebruikersnaam" Width="*" Binding="{Binding Username}"/>
                                    <DataGridTextColumn Header="Huidige Rol" Width="150" Binding="{Binding Role}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Left">
                                <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold">Nieuwe Rol:</TextBlock>
                                <ComboBox x:Name="cbNewRole" Width="150" Height="30" Margin="0,0,15,0">
                                    <ComboBoxItem>Admin</ComboBoxItem>
                                    <ComboBoxItem>Scheidsrechter</ComboBoxItem>
                                    <ComboBoxItem>Coach</ComboBoxItem>
                                </ComboBox>
                                <Button Name="btnChangeRole" Click="btnChangeRole_Click" Background="#2D8CFF" Foreground="White" Padding="15,5" Margin="0,0,10,0" FontWeight="SemiBold">Rol Wijzigen</Button>
                                <Button Name="btnDeleteUser" Click="btnDeleteUser_Click" Background="#E57373" Foreground="White" Padding="15,5" FontWeight="SemiBold">❌ Gebruiker Verwijderen</Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Margin="0,0,0,15" FontSize="16">Coach Toewijzen aan Team</TextBlock>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold">Coach:</TextBlock>
                                <ComboBox x:Name="cbCoaches" Width="180" Height="30" DisplayMemberPath="Username" Margin="0,0,20,0"/>

                                <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold">Team:</TextBlock>
                                <ComboBox x:Name="cbTeamsCoach" Width="180" Height="30" DisplayMemberPath="Name" Margin="0,0,20,0"/>

                                <Button Name="btnAssignCoach" Click="btnAssignCoach_Click" Background="DarkOliveGreen" Foreground="White" Padding="15,5" FontWeight="SemiBold">Coach Toewijzen</Button>
                                <Button Name="btnRemoveCoach" Click="btnRemoveCoach_Click"  Background="#8B3A3A" Foreground="White" Margin="10,0,0,0">Coach Ontkoppelen</Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="panelStatistieken" Visibility="Collapsed">
                    <TextBlock FontSize="28" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20">Competitie Statistieken</TextBlock>

                    <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Margin="0,0,0,10" FontSize="16">Actuele Competitiestand</TextBlock>

                            <DataGrid x:Name="dgStats" Height="300" AutoGenerateColumns="False" Background="White" BorderBrush="#DDD" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Width="50" Binding="{Binding Positie}"/>
                                    <DataGridTextColumn Header="Club" Width="*" Binding="{Binding Team}"/>
                                    <DataGridTextColumn Header="Punten" Width="100" Binding="{Binding Punten}"/>
                                    <DataGridTextColumn Header="Doelpunten Voor (DV)" Width="120" Binding="{Binding DV}"/>
                                    <DataGridTextColumn Header="Doelpunten Tegen (DT)" Width="120" Binding="{Binding DT}"/>
                                    <DataGridTextColumn Header="Doelsaldo" Width="100" Binding="{Binding Saldo}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>